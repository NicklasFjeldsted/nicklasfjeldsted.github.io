# Kopiér til .env.production på serveren og udfyld. Aldrig commit den rigtige fil.
API_DOMAIN=api.murerfirmaet-mvo.dk

# Brug lange tilfældige værdier uden specialtegn (fx: openssl rand -hex 24)
MYSQL_ROOT_PASSWORD=
MVO_DB_PASSWORD=

# Mindst 32 tegn (fx: openssl rand -base64 48)
JWT_KEY=

# Login til administrationssiden
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hvilke adresser frontenden kører på (tilføj evt. www)
CORS_ORIGIN_1=https://murerfirmaet-mvo.dk
CORS_ORIGIN_2=https://www.murerfirmaet-mvo.dk

# Mail fra tilbudsformularen (se afsnit 7.1 i docs/deployment/hetzner.md).
# Lad SMTP_HOST stå tom for at slå mail fra; henvendelser skrives så kun i API'ets log.
# Hetzner blokerer udgående port 25 og 465, så brug port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
# Afsenderen, typisk den samme konto som SMTP_USERNAME
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Murerfirmaet MVO
# Hvor nye forespørgsler sendes hen (tom = MAIL_FROM_ADDRESS)
MAIL_COMPANY_ADDRESS=
